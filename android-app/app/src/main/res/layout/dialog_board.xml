<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp">

    <EditText
        android:id="@+id/et_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="板块名称，例如：汽车"
        android:inputType="text"
        android:maxLength="20"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/et_icon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:hint="图标文字，1个字，例如：车"
        android:inputType="text"
        android:maxLength="1"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/et_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:hint="板块简介（选填）"
        android:inputType="text"
        android:maxLength="100"
        android:textSize="14sp" />

    <CheckBox
        android:id="@+id/cb_age"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="仅限年满 16 岁用户进入"
        android:textSize="13sp" />

    <CheckBox
        android:id="@+id/cb_password"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="需要密码才能访问"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/et_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="板块密码（选填，编辑时留空表示不修改）"
        android:inputType="text"
        android:maxLength="30"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
