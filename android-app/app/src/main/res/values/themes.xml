<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Xiaomu" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/green</item>
        <item name="colorPrimaryDark">@color/green_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="materialAlertDialogTheme">@style/Theme.Xiaomu.Dialog</item>
    </style>

    <style name="Theme.Xiaomu.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/green</item>
    </style>

    <style name="BtnGreen" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/green</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="ChipText">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_sub</item>
    </style>
</resources>
